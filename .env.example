# Pi-hole Backup to S3 Configuration
# ===================================
# Copy this file to .env and fill in your values

# Required: S3 bucket name for storing backups
PB2S3_AWS_BUCKET_NAME=your-bucket-name

# AWS Region (required)
# Can use either PB2S3_AWS_REGION or standard AWS_REGION
PB2S3_AWS_REGION=us-east-1

# AWS Credentials (Option 1: Application-specific credentials)
# Use these for dedicated Pi-hole backup credentials
PB2S3_AWS_ACCESS_KEY=your-access-key-id
PB2S3_AWS_SECRET_KEY=your-secret-access-key

# AWS Credentials (Option 2: Standard AWS SDK credentials)
# These are used if PB2S3_AWS_* credentials are not set
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key
# AWS_REGION=us-east-1

# Optional: Custom S3 endpoint
# Use for S3-compatible storage like MinIO, Backblaze B2, etc.
# PB2S3_S3_ENDPOINT=http://minio.local:9000
